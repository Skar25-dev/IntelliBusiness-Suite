# --- Base de datos (solo si db_type = postgresql; con Docker se usa siempre) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=suite_db

# --- Correo (SMTP). Para Gmail usa una "contraseña de aplicación" ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
